/-
Qminus.lean — the elementary certificate for deg Q⁻(7,2) ≥ 216 (GEO-1, GEO-2 in 07_geometry.md).

The data (points, lines, signs, doilies, grids) is GENERATED in Lean by `Qm7Data.lean`
(no big literals) and every property used below is checked by the single Boolean
`certificate216`, evaluated once by `native_decide` (trusts the Lean compiler, axiom
`Lean.ofReduceBool`). Everything else is proved by hand:

  grids are odd cycles               ⇒ each grid has ≥ 1 violated line      (odd-cycle lemma)
  60 grids per doily, coverage ≤ 24  ⇒ each doily has ≥ 3 violated lines   (60·1 > 24·2)
  4032 doilies in O_a, coverage ≤ 80 ⇒ |V ∩ O_a| ≥ 152                     (4032·3 > 80·151)
  136 sets O_a, coverage ≤ 96        ⇒ |V| ≥ 216                           (136·152 > 96·215)

Compared with the blueprint we use, for each doily, the 60 grids generated by ordered pairs of
disjoint lines (each of its 10 grids arises 6 times); the coverage 4 becomes 24.
Intermediate counts agree with code/cert216_full.py: 119 points, 1071 lines, 45696 doilies,
|famO a| = 4032, coverage 80, coverage of Q⁻ lines by the 136 O_a: 96.
-/
import PauliContextuality.Cover
import PauliData.Qm7Data

namespace PauliCtx.Qm7

open Config

/-- The certificate, evaluated by the compiler. -/
theorem certificate216_true : certificate216 = true := by
  native_decide

/-! ### Unpacking the certificate -/

theorem cert_parts :
    linesOK = true ∧ doilies.all doilyOK = true ∧ nonsing.length = 136 ∧ nonsing.all checkO = true ∧
    (List.range nL).all (fun j => decide (nonsing.countP (fun a => inO a j) ≤ 96)) = true := by
  have h := certificate216_true
  unfold certificate216 at h
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  exact ⟨h.1.1.1.1, h.1.1.1.2, h.1.1.2, h.1.2, h.2⟩

theorem lines_facts :
    nL = 1071 ∧
    (∀ j < nL, (lines[j]!).1 < (lines[j]!).2.1 ∧ (lines[j]!).2.1 < (lines[j]!).2.2 ∧
      (lines[j]!).2.2 < 119) ∧
    (∀ j < nL, ∀ k < nL, j = k ∨ lines[j]! ≠ lines[k]!) := by
  have h := cert_parts.1
  unfold linesOK at h
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range, decide_eq_true_eq,
    Bool.or_eq_true, bne_iff_ne, ne_eq] at h
  refine ⟨h.1.1.2, fun j hj => ?_, fun j hj k hk => h.2 j hj k hk⟩
  obtain ⟨⟨a, b⟩, c⟩ := h.1.2 j hj
  exact ⟨a, b, c⟩

-- the data must never be unfolded by the elaborator or kernel (it is only ever evaluated natively)
attribute [local irreducible] nL lines doilies nonsing lsgn

/-! ### Index-level model -/

/-- point index ↦ point of `Fin 119` -/
def fin (i : ℕ) : Fin 119 := ⟨i % 119, Nat.mod_lt _ (by norm_num)⟩

def sAt (s : Fin 119 → F) (i : ℕ) : F := s (fin i)

def eF (j : ℕ) : F := if lsgn j then 1 else 0

def lsum (s : Fin 119 → F) (j : ℕ) : F := ((lpl j).map (sAt s)).sum

def viol (s : Fin 119 → F) (j : ℕ) : Prop := lsum s j + eF j ≠ 0

instance (s : Fin 119 → F) (j : ℕ) : Decidable (viol s j) := by unfold viol; infer_instance

/-- the violated lines, as a set of line indices -/
def Vset (s : Fin 119 → F) : Finset ℕ := (Finset.range nL).filter (viol s)

/-! ### Generic lemmas -/

theorem sum_map_even_count (w : List ℕ) (f : ℕ → F) (hw : ∀ p ∈ w, w.count p % 2 = 0) :
    (w.map f).sum = 0 := by
  rw [Finset.sum_list_map_count]
  refine Finset.sum_eq_zero fun p hp => ?_
  have h := hw p (List.mem_toFinset.1 hp)
  obtain ⟨k, hk⟩ : ∃ k, w.count p = k + k := ⟨w.count p / 2, by omega⟩
  rw [hk, nsmul_eq_mul, Nat.cast_add, add_self_F, zero_mul]

theorem sum_map_eF (G : List ℕ) : (G.map eF).sum = ((G.countP lsgn : ℕ) : F) := by
  induction G with
  | nil => simp
  | cons j G ih =>
    rw [List.map_cons, List.sum_cons, ih, List.countP_cons]
    unfold eF
    split_ifs <;> simp [add_comm]

theorem sum_map_lsum (s : Fin 119 → F) (G : List ℕ) :
    (G.map (lsum s)).sum = ((ptsOfLines G).map (sAt s)).sum := by
  induction G with
  | nil => simp [ptsOfLines]
  | cons j G ih =>
    rw [List.map_cons, List.sum_cons, ih]
    simp [ptsOfLines, lsum, List.flatMap_cons]

/-- Odd-cycle lemma at the index level (CERT-1). -/
theorem odd_cycle_index (s : Fin 119 → F) (G : List ℕ)
    (hw : ∀ p ∈ ptsOfLines G, (ptsOfLines G).count p % 2 = 0) (hodd : G.countP lsgn % 2 = 1) :
    ∃ j ∈ G, viol s j := by
  by_contra hno
  push Not at hno
  have h1 : (G.map (fun j => lsum s j + eF j)).sum = 0 := by
    apply List.sum_eq_zero
    intro x hx
    obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hx
    have := hno j hj
    unfold viol at this
    exact not_not.1 this
  rw [List.sum_map_add, sum_map_lsum, sum_map_even_count _ _ hw, zero_add, sum_map_eF] at h1
  have h2 : ((G.countP lsgn : ℕ) : F) = ((G.countP lsgn % 2 : ℕ) : F) := (ZMod.natCast_mod _ 2).symm
  rw [h2, hodd] at h1
  exact one_ne_zero h1

/-- Double counting for a list-indexed family. -/
theorem sum_card_inter {γ : Type} (fam : List γ) (mem : γ → Finset ℕ) (V : Finset ℕ) :
    (fam.map (fun D => (V ∩ mem D).card)).sum = ∑ l ∈ V, fam.countP (fun D => decide (l ∈ mem D)) := by
  induction fam with
  | nil => simp
  | cons D fam ih =>
    rw [List.map_cons, List.sum_cons, ih]
    simp only [List.countP_cons]
    rw [Finset.sum_add_distrib, ← Finset.card_filter, add_comm]
    congr 1
    congr 1
    ext x
    simp

theorem len_mul_le_sum {γ : Type} (l : List γ) (f : γ → ℕ) (d : ℕ) (h : ∀ x ∈ l, d ≤ f x) :
    l.length * d ≤ (l.map f).sum := by
  induction l with
  | nil => simp
  | cons x l ih =>
    rw [List.length_cons, List.map_cons, List.sum_cons, Nat.succ_mul]
    have := ih (fun y hy => h y (List.mem_cons_of_mem _ hy))
    have := h x List.mem_cons_self
    omega

/-- List uniform-cover lemma (TR-1'): `|fam| d ≤ c |V|`. -/
theorem list_cover {γ : Type} (fam : List γ) (mem : γ → Finset ℕ) (V : Finset ℕ) (c d : ℕ)
    (hdeg : ∀ D ∈ fam, d ≤ (V ∩ mem D).card)
    (hcov : ∀ l ∈ V, fam.countP (fun D => decide (l ∈ mem D)) ≤ c) :
    fam.length * d ≤ c * V.card := by
  calc fam.length * d ≤ (fam.map (fun D => (V ∩ mem D).card)).sum := len_mul_le_sum _ _ _ hdeg
    _ = ∑ l ∈ V, fam.countP (fun D => decide (l ∈ mem D)) := sum_card_inter _ _ _
    _ ≤ ∑ _l ∈ V, c := Finset.sum_le_sum hcov
    _ = c * V.card := by rw [Finset.sum_const, smul_eq_mul, mul_comm]

theorem countP_contains_eq (fam : List (List ℕ)) (l : ℕ) :
    fam.countP (fun D => decide (l ∈ D.toFinset)) = fam.countP (fun D => D.contains l) := by
  apply List.countP_congr
  intro D _
  simp [List.mem_toFinset]

/-! ### Step 1: every doily has ≥ 3 violated lines -/

theorem doily_ge_three (s : Fin 119 → F) (D : List ℕ) (hD : doilyOK D = true) :
    3 ≤ (Vset s ∩ D.toFinset).card := by
  unfold doilyOK at hD
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at hD
  obtain ⟨hlt, ⟨hlen, hgrids⟩, hcov⟩ := hD
  set V' := Vset s ∩ D.toFinset with hV'
  have key := list_cover (gridsOf D) List.toFinset V' 24 1 ?_ ?_
  · rw [hlen] at key
    omega
  · intro G hG
    have hok := hgrids G hG
    unfold gridOK at hok
    simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at hok
    obtain ⟨⟨hsub, hw⟩, hodd⟩ := hok
    obtain ⟨j, hjG, hj⟩ := odd_cycle_index s G (fun p hp => by simpa using hw p hp) hodd
    have hjD : j ∈ D := by simpa using hsub j hjG
    rw [Nat.one_le_iff_ne_zero, Ne, Finset.card_eq_zero, ← Ne, ← Finset.nonempty_iff_ne_empty]
    refine ⟨j, ?_⟩
    simp only [hV', Vset, Finset.mem_inter, Finset.mem_filter, Finset.mem_range, List.mem_toFinset]
    exact ⟨⟨⟨hlt j hjD, hj⟩, hjD⟩, hjG⟩
  · intro l hl
    rw [countP_contains_eq]
    have hlD : l ∈ D := by
      rw [hV', Finset.mem_inter, List.mem_toFinset] at hl
      exact hl.2
    exact hcov l hlD

/-! ### Step 2: |V ∩ O_a| ≥ 152 -/

def Oset (a : ℕ) : Finset ℕ := (Finset.range nL).filter (fun j => inO a j = true)

theorem doilies_ok : ∀ D ∈ doilies, doilyOK D = true := by
  have h := cert_parts.2.1
  simpa only [List.all_eq_true] using h

theorem Oa_ge_152 (s : Fin 119 → F) (a : ℕ) (ha : checkO a = true) :
    152 ≤ (Vset s ∩ Oset a).card := by
  unfold checkO at ha
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range, Bool.or_eq_true,
    Bool.not_eq_true', decide_eq_true_eq] at ha
  obtain ⟨hlen, hcov⟩ := ha
  set V'' := Vset s ∩ Oset a with hV''
  have key := list_cover (famO a) List.toFinset V'' 80 3 ?_ ?_
  · rw [hlen] at key
    omega
  · intro D hD
    have hD' : D ∈ doilies ∧ D.all (inO a) = true := by
      simpa [famO, List.mem_filter] using hD
    have h3 := doily_ge_three s D (doilies_ok D hD'.1)
    refine le_trans h3 (Finset.card_le_card ?_)
    intro j hj
    rw [Finset.mem_inter] at hj
    rw [hV'', Finset.mem_inter, Finset.mem_inter]
    refine ⟨⟨hj.1, ?_⟩, hj.2⟩
    rw [Oset, Finset.mem_filter]
    exact ⟨(Finset.mem_filter.1 hj.1).1, (List.all_eq_true.1 hD'.2) j (List.mem_toFinset.1 hj.2)⟩
  · intro l hl
    rw [countP_contains_eq]
    simp only [hV'', Oset, Finset.mem_inter, Finset.mem_filter, Finset.mem_range] at hl
    rcases hcov l hl.2.1 with h | h
    · rw [hl.2.2] at h; exact absurd h (by simp)
    · exact h

/-! ### Step 3: |V| ≥ 216 -/

theorem viol_ge_216 (s : Fin 119 → F) : 216 ≤ (Vset s).card := by
  obtain ⟨_, _, hlen, hO, hcovQ⟩ := cert_parts
  simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hO hcovQ
  have key := list_cover nonsing Oset (Vset s) 96 152 ?_ ?_
  · rw [hlen] at key
    omega
  · intro a ha
    exact Oa_ge_152 s a (hO a ha)
  · intro l hl
    have hl' : l < nL := Finset.mem_range.1 (Finset.mem_filter.1 hl).1
    have : nonsing.countP (fun a => decide (l ∈ Oset a)) = nonsing.countP (fun a => inO a l) := by
      apply List.countP_congr
      intro a _
      simp [Oset, hl']
    rw [this]
    exact hcovQ l hl'

/-! ### Bridge to the abstract configuration -/

/-- the point set of line `j` -/
def L (j : ℕ) : Finset (Fin 119) := ((lpl j).map fin).toFinset

theorem fin_val {i : ℕ} (h : i < 119) : (fin i).val = i := Nat.mod_eq_of_lt h

theorem lpl_nodup {j : ℕ} (hj : j < nL) : ((lpl j).map fin).Nodup := by
  obtain ⟨h1, h2, h3⟩ := lines_facts.2.1 j hj
  apply List.Nodup.map_on
  · intro x hx y hy hxy
    have hx' : x < 119 := by simp only [lpl, List.mem_cons, List.not_mem_nil, or_false] at hx; omega
    have hy' : y < 119 := by simp only [lpl, List.mem_cons, List.not_mem_nil, or_false] at hy; omega
    have := congrArg Fin.val hxy
    rwa [fin_val hx', fin_val hy'] at this
  · refine List.nodup_cons.2 ⟨?_, List.nodup_cons.2 ⟨?_, List.nodup_cons.2 ⟨List.not_mem_nil, List.nodup_nil⟩⟩⟩
    · simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
      exact ⟨by omega, by omega⟩
    · simp only [List.mem_cons, List.not_mem_nil, or_false]
      omega

theorem mem_L {j : ℕ} (hj : j < nL) (i : ℕ) (hi : i < 119) :
    fin i ∈ L j ↔ i = (lines[j]!).1 ∨ i = (lines[j]!).2.1 ∨ i = (lines[j]!).2.2 := by
  obtain ⟨h1, h2, h3⟩ := lines_facts.2.1 j hj
  simp only [L, lpl, List.map_cons, List.map_nil, List.mem_toFinset, List.mem_cons,
    List.not_mem_nil, or_false]
  constructor
  · rintro (h | h | h) <;> have := congrArg Fin.val h <;>
      rw [fin_val hi, fin_val (by omega)] at this <;> omega
  · rintro (h | h | h) <;> rw [h] <;> simp

theorem L_inj {j k : ℕ} (hj : j < nL) (hk : k < nL) (h : L j = L k) : j = k := by
  obtain ⟨a1, a2, a3⟩ := lines_facts.2.1 j hj
  obtain ⟨b1, b2, b3⟩ := lines_facts.2.1 k hk
  have m : ∀ i < 119, (i = (lines[j]!).1 ∨ i = (lines[j]!).2.1 ∨ i = (lines[j]!).2.2) ↔
      (i = (lines[k]!).1 ∨ i = (lines[k]!).2.1 ∨ i = (lines[k]!).2.2) := fun i hi => by
    rw [← mem_L hj i hi, ← mem_L hk i hi, h]
  have e1 := (m (lines[j]!).1 (by omega)).1 (Or.inl rfl)
  have e2 := (m (lines[j]!).2.1 (by omega)).1 (Or.inr (Or.inl rfl))
  have e3 := (m (lines[j]!).2.2 (by omega)).1 (Or.inr (Or.inr rfl))
  have f1 := (m (lines[k]!).1 (by omega)).2 (Or.inl rfl)
  have f2 := (m (lines[k]!).2.1 (by omega)).2 (Or.inr (Or.inl rfl))
  have f3 := (m (lines[k]!).2.2 (by omega)).2 (Or.inr (Or.inr rfl))
  have heq : lines[j]! = lines[k]! := by
    have g1 : (lines[j]!).1 = (lines[k]!).1 := by omega
    have g2 : (lines[j]!).2.1 = (lines[k]!).2.1 := by omega
    have g3 : (lines[j]!).2.2 = (lines[k]!).2.2 := by omega
    exact Prod.ext g1 (Prod.ext g2 g3)
  rcases lines_facts.2.2 j hj k hk with h' | h'
  · exact h'
  · exact absurd heq h'

theorem card_L {j : ℕ} (hj : j < nL) : (L j).card = 3 := by
  rw [L, List.toFinset_card_of_nodup (lpl_nodup hj), List.length_map]
  rfl

theorem sum_L (s : Fin 119 → F) {j : ℕ} (hj : j < nL) : ∑ p ∈ L j, s p = lsum s j := by
  rw [L, List.sum_toFinset _ (lpl_nodup hj), List.map_map]
  rfl

/-- The abstract configuration Q⁻(7,2) on the 119 singular points. -/
noncomputable def config : Config (Fin 119) where
  lines := (Finset.range nL).image L
  sign := fun l => ∑ j ∈ Finset.range nL, if L j = l then eF j else 0
  three := by
    intro l hl
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 hl
    exact card_L (Finset.mem_range.1 hj)

theorem config_sign_apply (l : Finset (Fin 119)) :
    config.sign l = ∑ k ∈ Finset.range nL, if L k = l then eF k else 0 := rfl

theorem config_sign {j : ℕ} (hj : j < nL) : config.sign (L j) = eF j := by
  rw [config_sign_apply, Finset.sum_eq_single j]
  · exact if_pos rfl
  · intro k hk hkj
    rw [if_neg]
    intro h
    exact hkj (L_inj (Finset.mem_range.1 hk) hj h)
  · intro h
    exact absurd (Finset.mem_range.2 hj) h

theorem config_violated (s : Fin 119 → F) : config.violated s = (Vset s).image L := by
  ext l
  simp only [Config.violated, Config.Violated, Finset.mem_filter, Finset.mem_image, Vset,
    Finset.mem_range]
  constructor
  · rintro ⟨hl, hv⟩
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 hl
    have hj' := Finset.mem_range.1 hj
    refine ⟨j, ⟨hj', ?_⟩, rfl⟩
    rw [sum_L s hj', config_sign hj'] at hv
    exact hv
  · rintro ⟨j, ⟨hj, hv⟩, rfl⟩
    refine ⟨Finset.mem_image.2 ⟨j, Finset.mem_range.2 hj, rfl⟩, ?_⟩
    rw [sum_L s hj, config_sign hj]
    exact hv

theorem card_violated (s : Fin 119 → F) : (config.violated s).card = (Vset s).card := by
  rw [config_violated, Finset.card_image_of_injOn]
  intro j hj k hk h
  exact L_inj (Finset.mem_range.1 (Finset.mem_filter.1 hj).1)
    (Finset.mem_range.1 (Finset.mem_filter.1 hk).1) h

/-- MAIN (GEO-2): deg Q⁻(7,2) ≥ 216. -/
theorem qm7_ge_216 : 216 ≤ config.deg := by
  obtain ⟨s, hs⟩ := config.exists_opt
  rw [← hs, card_violated]
  exact viol_ge_216 s

/-- GEO-1: deg Q⁻(7,2) ≥ 215 (a weaker corollary). -/
theorem qm7_ge_215 : 215 ≤ config.deg := le_trans (by norm_num) qm7_ge_216

/-! ### GEO-5: the upper bound deg Q⁻(7,2) ≤ 315 (witness `certificates/witness_Qm7_2.txt`) -/

theorem witnessOK_true : witnessOK = true := by
  native_decide

/-- the witness assignment -/
def sW : Fin 119 → F := fun p => if wbit p.val then 1 else 0

theorem card_range_filter (n : ℕ) (P : ℕ → Prop) [DecidablePred P] :
    ((Finset.range n).filter P).card = (List.range n).countP (fun j => decide (P j)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.range_add_one, Finset.filter_insert, List.range_succ, List.countP_append, ← ih]
    by_cases h : P n
    · rw [if_pos h, Finset.card_insert_of_notMem (by simp)]
      simp [h]
    · rw [if_neg h]; simp [h]

theorem b2f_viol (x y z w : Bool) :
    ((if x then (1 : F) else 0) + ((if y then 1 else 0) + ((if z then 1 else 0) + 0)) +
      (if w then 1 else 0) ≠ 0) ↔ ((x ^^ y ^^ z) != w) = true := by
  revert x y z w; decide

theorem viol_sW {j : ℕ} (hj : j < nL) : viol sW j ↔ violW j = true := by
  obtain ⟨h1, h2, h3⟩ := lines_facts.2.1 j hj
  have hs : ∀ i < 119, sAt sW i = if wbit i then 1 else 0 := by
    intro i hi; simp [sAt, sW, fin_val hi]
  unfold viol lsum eF violW
  simp only [lpl, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  rw [hs _ (by omega), hs _ (by omega), hs _ h3]
  exact b2f_viol _ _ _ _

/-- GEO-5: deg Q⁻(7,2) ≤ 315. -/
theorem qm7_le_315 : config.deg ≤ 315 := by
  have hcount : (Vset sW).card = 315 := by
    have h := witnessOK_true
    unfold witnessOK at h
    rw [beq_iff_eq] at h
    rw [Vset, card_range_filter, ← h]
    apply List.countP_congr
    intro j hj
    rw [List.mem_range] at hj
    simp [viol_sW hj]
  calc config.deg ≤ (config.violated sW).card := config.deg_le sW
    _ = 315 := by rw [card_violated, hcount]

/-- Both bounds: 216 ≤ deg Q⁻(7,2) ≤ 315. -/
theorem qm7_bounds : 216 ≤ config.deg ∧ config.deg ≤ 315 := ⟨qm7_ge_216, qm7_le_315⟩

end PauliCtx.Qm7
