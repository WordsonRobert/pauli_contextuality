/-
QminusBridge.lean — the certificate of Qminus.lean is about Q⁻(7,2) as defined from first principles.

`QM` is the set of singular points of `qminus` (Basic.lean) in `V 4`, and `Qminus7 := configX QM`
(SpectralConfig.lean) is the configuration of ALL commuting triples {a, b, a+b} ⊆ QM with the
Pauli-product sign. We show that the 1071 lines generated by `Qm7Data` are exactly the lines of
`Qminus7` (after decoding bit-packed labels), with the same signs, and transfer both bounds:

    216 ≤ deg Q⁻(7,2) ≤ 315.

The three finite facts `bridge_pairs`, `bridge_lines`, `bridge_inj` are checked by `native_decide`.
-/
import PauliContextuality.Qminus
import PauliContextuality.SpectralConfig

namespace PauliCtx.Qm7

open Config Spectral

/-- Q⁻(7,2): the non-zero singular points of `q⁻(x|z) = x·z + x₁ + z₁` -/
def QM : Finset (V 4) := Finset.univ.filter (fun p => p ≠ 0 ∧ qminus p = 0)

theorem zero_not_mem_QM : (0 : V 4) ∉ QM := by simp [QM]

/-- the configuration Q⁻(7,2), defined from Basic.lean (all commuting triples of singular points) -/
noncomputable def Qminus7 : Config (V 4) := configX QM zero_not_mem_QM

/-- decoding of bit-packed labels: bits 0..3 = x, bits 4..7 = z -/
def decodeBits (v : ℕ) : V 4 :=
  (fun k => if v.testBit k.val then 1 else 0, fun k => if v.testBit (4 + k.val) then 1 else 0)

def encodeBits (p : V 4) : ℕ := ∑ k : Fin 4, ((p.1 k).val * 2 ^ k.val + (p.2 k).val * 2 ^ (4 + k.val))

/-- decoded point of index `i` -/
def decP (i : ℕ) : V 4 := decodeBits pts[i]!

/-- the decoded point set of data line `j` -/
def Ld (j : ℕ) : Finset (V 4) := ((lpl j).map decP).toFinset

/-- the data line through an ordered pair -/
def lookup (p : V 4 × V 4) : ℕ := lineOf (idxOf[encodeBits p.1]!) (idxOf[encodeBits p.2]!)

def pairOf (j : ℕ) : V 4 × V 4 := (decP (lines[j]!).1, decP (lines[j]!).2.1)

theorem bridge_pairs : ∀ p ∈ OP QM, lookup p < nL ∧ tri p = Ld (lookup p) := by native_decide

theorem bridge_lines_bool : ((List.range nL).all fun j =>
    decide (pairOf j ∈ OP QM) && decide (tri (pairOf j) = Ld j) && decide (sgnF (pairOf j) = eF j)) = true := by
  native_decide

attribute [local irreducible] nL lines doilies nonsing lsgn

set_option maxRecDepth 200000 in
theorem bridge_lines : ∀ j < nL, pairOf j ∈ OP QM ∧ tri (pairOf j) = Ld j ∧ sgnF (pairOf j) = eF j := by
  intro j hj
  have h := List.all_eq_true.1 bridge_lines_bool j (List.mem_range.2 hj)
  simp only [Bool.and_eq_true] at h
  exact ⟨@of_decide_eq_true _ _ h.1.1, @of_decide_eq_true _ _ h.1.2, @of_decide_eq_true _ _ h.2⟩

set_option maxRecDepth 100000 in
theorem bridge_inj_bool : ((List.range 119).all fun i => (List.range 119).all fun k =>
    !(decide (decP i = decP k)) || i == k) = true := by native_decide

attribute [local irreducible] QM OP decP

theorem bridge_inj : ∀ i < 119, ∀ k < 119, decP i = decP k → i = k := by
  intro i hi k hk h
  have := List.all_eq_true.1 (List.all_eq_true.1 bridge_inj_bool i (List.mem_range.2 hi)) k
    (List.mem_range.2 hk)
  simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, beq_iff_eq] at this
  exact this.resolve_left (not_not.2 h)

/-- decoded points as a map on `Fin 119` -/
def dec' (i : Fin 119) : V 4 := decP i.val

theorem dec'_inj : Function.Injective dec' := fun i k h => Fin.ext (bridge_inj i.val i.2 k.val k.2 h)

theorem Ld_eq {j : ℕ} (hj : j < nL) : Ld j = (L j).image dec' := by
  obtain ⟨h1, h2, h3⟩ := lines_facts.2.1 j hj
  have hlt : ∀ i ∈ lpl j, i < 119 := by
    intro i hi
    simp only [lpl, List.mem_cons, List.not_mem_nil, or_false] at hi
    omega
  unfold Ld L
  ext x
  simp only [List.mem_toFinset, List.mem_map, Finset.mem_image]
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨fin i, ⟨i, hi, rfl⟩, by simp only [dec', fin_val (hlt i hi)]⟩
  · rintro ⟨y, ⟨i, hi, rfl⟩, rfl⟩
    exact ⟨i, hi, by simp only [dec', fin_val (hlt i hi)]⟩

theorem Qminus7_lines : Qminus7.lines = (Finset.range nL).image Ld := by
  ext l
  simp only [Qminus7, configX, Finset.mem_image, Finset.mem_range]
  constructor
  · rintro ⟨p, hp, rfl⟩
    obtain ⟨h1, h2⟩ := bridge_pairs p hp
    exact ⟨lookup p, h1, h2.symm⟩
  · rintro ⟨j, hj, rfl⟩
    obtain ⟨h1, h2, -⟩ := bridge_lines j hj
    exact ⟨pairOf j, h1, h2⟩

theorem Qminus7_sign {j : ℕ} (hj : j < nL) : Qminus7.sign (Ld j) = eF j := by
  obtain ⟨h1, h2, h3⟩ := bridge_lines j hj
  rw [← h2, ← h3]
  exact configX_sign zero_not_mem_QM h1

theorem Ld_inj {j k : ℕ} (hj : j < nL) (hk : k < nL) (h : Ld j = Ld k) : j = k := by
  rw [Ld_eq hj, Ld_eq hk] at h
  exact L_inj hj hk (Finset.image_injective dec'_inj h)

theorem sum_Ld (s : V 4 → F) {j : ℕ} (hj : j < nL) : ∑ x ∈ Ld j, s x = lsum (s ∘ dec') j := by
  rw [Ld_eq hj, Finset.sum_image (fun x _ y _ h => dec'_inj h), ← sum_L (s ∘ dec') hj]
  rfl

theorem Qminus7_violated (s : V 4 → F) : Qminus7.violated s = (Vset (s ∘ dec')).image Ld := by
  ext l
  simp only [Config.violated, Config.Violated, Finset.mem_filter, Qminus7_lines, Finset.mem_image,
    Finset.mem_range, Vset]
  constructor
  · rintro ⟨⟨j, hj, rfl⟩, hv⟩
    refine ⟨j, ⟨hj, ?_⟩, rfl⟩
    rw [sum_Ld s hj, Qminus7_sign hj] at hv
    exact hv
  · rintro ⟨j, ⟨hj, hv⟩, rfl⟩
    refine ⟨⟨j, hj, rfl⟩, ?_⟩
    rw [sum_Ld s hj, Qminus7_sign hj]
    exact hv

theorem Qminus7_card_violated (s : V 4 → F) :
    (Qminus7.violated s).card = (Vset (s ∘ dec')).card := by
  rw [Qminus7_violated, Finset.card_image_of_injOn]
  intro j hj k hk h
  exact Ld_inj (Finset.mem_range.1 (Finset.mem_filter.1 hj).1) (Finset.mem_range.1 (Finset.mem_filter.1 hk).1) h

/-- **GEO-2 for Q⁻(7,2) defined from first principles**: deg Q⁻(7,2) ≥ 216. -/
theorem Qminus7_ge_216 : 216 ≤ Qminus7.deg := by
  obtain ⟨s, hs⟩ := Qminus7.exists_opt
  rw [← hs, Qminus7_card_violated]
  exact viol_ge_216 _

/-- **GEO-5 for Q⁻(7,2)**: deg Q⁻(7,2) ≤ 315. -/
theorem Qminus7_le_315 : Qminus7.deg ≤ 315 := by
  classical
  let s : V 4 → F := fun x => if h : ∃ i, dec' i = x then sW (Classical.choose h) else 0
  have hs : s ∘ dec' = sW := by
    funext i
    have h : ∃ k, dec' k = dec' i := ⟨i, rfl⟩
    simp only [Function.comp_apply, s, dif_pos h]
    rw [dec'_inj (Classical.choose_spec h)]
  have hW : (Vset sW).card = 315 := by
    have := card_violated sW
    have h2 : (config.violated sW).card = 315 := by
      have h := qm7_le_315
      -- recompute: the witness count
      have hc := witnessOK_true
      unfold witnessOK at hc
      rw [beq_iff_eq] at hc
      rw [card_violated, Vset, card_range_filter, ← hc]
      apply List.countP_congr
      intro j hj
      rw [List.mem_range] at hj
      simp [viol_sW hj]
    rw [← this, h2]
  calc Qminus7.deg ≤ (Qminus7.violated s).card := Qminus7.deg_le s
    _ = 315 := by rw [Qminus7_card_violated, hs, hW]

theorem Qminus7_bounds : 216 ≤ Qminus7.deg ∧ Qminus7.deg ≤ 315 := ⟨Qminus7_ge_216, Qminus7_le_315⟩

end PauliCtx.Qm7
